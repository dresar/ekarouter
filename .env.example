# EkaRouter Developer Platform Configuration

# Server Environment (development | production)
EKAROUTER_ENV=production

# Network Bindings
EKAROUTER_HOST=0.0.0.0
EKAROUTER_PORT=8080

# Database Configuration (SQLite path)
EKAROUTER_DB_PATH=data/ekarouter.db

# Master Cryptographic Secrets (Minimum 32 characters recommended for production)
EKAROUTER_SECRET_KEY=replace_with_32_character_master_encryption_key_here
EKAROUTER_SESSION_SECRET=replace_with_32_character_session_signing_secret_here

# Default Admin Credentials
EKAROUTER_ADMIN_USER=admin
EKAROUTER_ADMIN_PASSWORD=replace_with_secure_admin_password_here

# Network Security & Proxies
EKAROUTER_ALLOW_LOCAL_PROVIDERS=false
EKAROUTER_ENABLE_PROXY=true
EKAROUTER_CORS_ORIGINS=*

# Token Saver Optimization (off | safe | balanced)
EKAROUTER_TOKEN_SAVER_MODE=safe

# HTTP Limits & Timeouts
EKAROUTER_MAX_BODY_BYTES=10485760
EKAROUTER_REQUEST_TIMEOUT=30s
EKAROUTER_RATE_LIMIT=120

# Scheduler & Retention
EKAROUTER_ENABLE_SCHEDULER=true
EKAROUTER_LOG_RETENTION_DAYS=30
EKAROUTER_HEALTH_CHECK_INTERVAL=60s
EKAROUTER_ENABLE_PAYLOAD_LOGGING=false
