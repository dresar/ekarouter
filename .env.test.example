# EkaRouter Test Environment Configuration Template
# Used for automated QA, integration, and E2E testing

# Environment Mode
EKAROUTER_ENV=test

# Network Configuration (Loopback only for test safety)
EKAROUTER_HOST=127.0.0.1
EKAROUTER_PORT=8999

# Dedicated Isolated Test Database
EKAROUTER_DB_PATH=data/test_ekarouter.db

# Cryptographic Master Key for Test Vault (Isolated 32-char key)
EKAROUTER_SECRET_KEY=test-master-encryption-key-32chars!

# Test Administrator Credentials
EKAROUTER_ADMIN_USER=admin
EKAROUTER_ADMIN_PASSWORD=admin-test-password

# Local Provider & SSRF Sandbox (Enabled for local test mock servers)
EKAROUTER_ALLOW_LOCAL_PROVIDERS=true

# Optimization & Middleware Limits
EKAROUTER_TOKEN_SAVER_MODE=safe
EKAROUTER_MAX_BODY_BYTES=10485760
EKAROUTER_CORS_ORIGINS=*

# Timeouts
EKAROUTER_REQUEST_TIMEOUT=10s
EKAROUTER_READ_TIMEOUT=10s
EKAROUTER_WRITE_TIMEOUT=10s
EKAROUTER_IDLE_TIMEOUT=10s

# Log Retention
EKAROUTER_LOG_RETENTION_DAYS=7

# Live Provider Testing Flag (Default: false to prevent external API calls & costs)
# Set to 'true' only when explicitly testing configured real credentials
EKAROUTER_ENABLE_LIVE_PROVIDER_TESTS=false
